# Local development. Move to the server by changing DATABASE_URL only.
DATABASE_URL=postgresql://user:pass@host:5432/nse_eod
DATA_DIR=Z:/nse_eod_pipeline/data
LOG_DIR=Z:/nse_eod_pipeline/logs
# Freshness stamp published by `last-success` and read by the morning brief.
# Contents are DB-derived, so consumers must read last_success_at, not the mtime.
# HEARTBEAT_PATH=Z:/nse_eod_pipeline/data/heartbeat.json
# ALERT_WEBHOOK_URL=
BACKFILL_START=2020-01-01
